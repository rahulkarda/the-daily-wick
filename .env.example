# Required for daily generation pipeline
GEMINI_API_KEY=

# Required for hero-image fetching (primary)
UNSPLASH_ACCESS_KEY=

# Optional fallback image provider — used when Unsplash returns nothing
# usable for any of the three queries Gemini suggests.
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Required for newsletter sending
BUTTONDOWN_API_KEY=

# Site URL — used in email absolute URLs and OG tags
SITE_URL=http://localhost:4321

# Curator name shown in bylines and AI-disclosure footer
CURATOR_NAME=Rahul Karda

# Optional — force one format on the next run. Otherwise the generator
# rotates: micro Mon/Wed/Fri, essay Tue/Thu.
# FORMAT=micro
