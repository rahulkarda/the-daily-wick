{
  "name": "the-daily-wick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Daily Wick — a small flame, every morning. Fully-automated daily blog + newsletter.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "generate": "node scripts/generate-daily-post.mjs",
    "generate:dry-run": "node scripts/dev/dry-run.mjs",
    "send": "node scripts/send-daily-newsletter.mjs",
    "send:dry-run": "node scripts/send-daily-newsletter.mjs --dry-run",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "@fontsource-variable/inter": "^5.0.0",
    "@fontsource/fraunces": "^5.0.0",
    "astro": "^5.13.0",
    "gray-matter": "^4.0.3",
    "marked": "^14.0.0",
    "reading-time": "^1.5.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@pagefind/default-ui": "^1.1.0",
    "pagefind": "^1.1.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.6.0"
  }
}
