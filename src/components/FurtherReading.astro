---
interface Item {
  label: string;
  url: string;
  kind?: 'book' | 'essay' | 'paper' | 'podcast' | 'video' | 'site';
  note?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const hasItems = items && items.length > 0;

// Tiny SVG icons keyed by kind. Inline so we avoid an icon-library dep.
const ICON: Record<NonNullable<Item['kind']>, string> = {
  book: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>',
  essay: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  paper: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>',
  podcast: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/></svg>',
  video: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>',
  site: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
};
---

<aside class="further-reading">
  <h2 class="further-reading__heading">If this hooked you</h2>
  <p class="further-reading__sub">Where we'd send you next.</p>
  <ul class="further-reading__list">
    {hasItems && items.map((item) => {
      const kind = item.kind ?? 'essay';
      return (
        <li class="fr-item">
          <a class="fr-item__link" href={item.url} target="_blank" rel="noopener">
            <span class="fr-item__icon" aria-hidden="true" set:html={ICON[kind]}></span>
            <span class="fr-item__body">
              <span class="fr-item__label">{item.label}</span>
              {item.note && <span class="fr-item__note">{item.note}</span>}
            </span>
            <span class="fr-item__kind">{kind}</span>
          </a>
        </li>
      );
    })}
  </ul>
</aside>

<style>
  .further-reading {
    margin-top: 3rem;
    padding: 1.5rem 1.5rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
  }
  .further-reading__heading {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    margin: 0 0 0.25rem;
    letter-spacing: -0.01em;
  }
  .further-reading__sub {
    color: var(--text-muted);
    font-size: var(--step--1);
    font-style: italic;
    font-family: var(--font-serif);
    margin: 0 0 1rem;
  }
  .further-reading__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .fr-item__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 0.75rem;
    padding: 0.75rem 0.5rem;
    border-bottom: 1px dashed var(--rule);
    color: var(--text);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .fr-item:last-child .fr-item__link {
    border-bottom: 0;
  }
  .fr-item__link:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .fr-item__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .fr-item__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .fr-item__label {
    font-weight: 500;
    line-height: 1.3;
  }
  .fr-item__note {
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.45;
  }
  .fr-item__kind {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    align-self: center;
  }
</style>
