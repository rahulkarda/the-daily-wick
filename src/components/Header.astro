---
import { SITE, NAV } from '@/consts';
import { path } from '@/lib/path';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const BASE = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const isActive = (href: string) => {
  const p = `${BASE}${href === '/' ? '' : href}`;
  return href === '/' ? pathname === BASE + '/' || pathname === BASE || pathname === '/' : pathname === p || pathname.startsWith(p + '/');
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={path('/')} class="brand">
      <span class="brand__name">{SITE.name}</span>
      <span class="brand__tagline">{SITE.tagline}</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {NAV.map(({ label, href }) => (
          <li>
            <a
              href={path(href)}
              class:list={[isActive(href) && 'is-active']}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button
        id="open-search"
        type="button"
        class="search-button"
        aria-label="Open search"
        title="Search (⌘K)"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>
      <ThemeToggle />
      <a href={path('/subscribe')} class="subscribe-pill">Subscribe</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    padding-block: 1rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    text-decoration: none;
    color: inherit;
  }
  .brand:hover {
    color: inherit;
    text-decoration: none;
  }
  .brand__name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  .brand__tagline {
    font-size: var(--step--2);
    color: var(--text-muted);
    font-style: italic;
    letter-spacing: 0.02em;
    margin-top: 2px;
  }

  .primary-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    flex-wrap: nowrap;
  }

  .primary-nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--step--1);
    padding-block: 0.25rem;
    position: relative;
    white-space: nowrap;
    transition: color 150ms ease;
  }
  .primary-nav a:hover {
    color: var(--text);
  }
  .primary-nav a.is-active {
    color: var(--text);
  }
  .primary-nav a.is-active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .search-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    color: var(--text-muted);
    transition: background-color 150ms ease, color 150ms ease;
  }
  .search-button:hover {
    background-color: var(--accent-soft);
    color: var(--accent);
  }

  .subscribe-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    background: var(--text);
    color: var(--bg);
    font-size: var(--step--1);
    font-weight: 500;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 150ms ease, background-color 150ms ease;
  }
  .subscribe-pill:hover {
    color: var(--bg);
    text-decoration: none;
    background: var(--accent);
    transform: translateY(-1px);
  }

  @media (max-width: 720px) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      row-gap: 0.5rem;
    }
    .header-actions {
      grid-row: 1;
      grid-column: 2;
    }
    .primary-nav {
      grid-row: 2;
      grid-column: 1 / -1;
      overflow-x: auto;
    }
    .primary-nav ul {
      justify-content: flex-start;
    }
    .brand__tagline {
      display: none;
    }
  }
</style>
