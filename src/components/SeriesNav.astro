---
import type { CollectionEntry } from 'astro:content';
import { path } from '@/lib/path';

interface Props {
  context: {
    def: { slug: string; title: string; description?: string };
    index: number;
    siblings: CollectionEntry<'posts'>[];
  };
  currentSlug: string;
}

const { context, currentSlug } = Astro.props;
const { def, siblings } = context;
const myIdx = siblings.findIndex((s) => s.slug === currentSlug);
const prev = myIdx > 0 ? siblings[myIdx - 1] : null;
const next = myIdx >= 0 && myIdx < siblings.length - 1 ? siblings[myIdx + 1] : null;
---

<nav class="series-nav" aria-label={`Series: ${def.title}`}>
  <p class="series-nav__eyebrow">
    Part of <a href={path(`/series/${def.slug}`)}>{def.title}</a> · {myIdx + 1} of {siblings.length}
  </p>
  <ol class="series-nav__list">
    {siblings.map((s, idx) => {
      const isCurrent = s.slug === currentSlug;
      return (
        <li class:list={['series-nav__item', isCurrent && 'is-current']}>
          {isCurrent ? (
            <span aria-current="page">{idx + 1}. {s.data.title}</span>
          ) : (
            <a href={path(`/articles/${s.slug}`)}>{idx + 1}. {s.data.title}</a>
          )}
        </li>
      );
    })}
  </ol>
  <div class="series-nav__pager">
    {prev ? (
      <a class="series-nav__pager-link" href={path(`/articles/${prev.slug}`)} rel="prev">
        <span class="series-nav__pager-label">← Previous</span>
        <span class="series-nav__pager-title">{prev.data.title}</span>
      </a>
    ) : <span></span>}
    {next ? (
      <a class="series-nav__pager-link series-nav__pager-link--next" href={path(`/articles/${next.slug}`)} rel="next">
        <span class="series-nav__pager-label">Next →</span>
        <span class="series-nav__pager-title">{next.data.title}</span>
      </a>
    ) : <span></span>}
  </div>
</nav>

<style>
  .series-nav {
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
  }
  .series-nav__eyebrow {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
  }
  .series-nav__eyebrow a {
    color: var(--accent);
  }
  .series-nav__list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-bottom: 1px dashed var(--rule);
    padding-bottom: 1rem;
  }
  .series-nav__item {
    font-size: var(--step--1);
  }
  .series-nav__item a {
    color: var(--text);
    text-decoration: none;
  }
  .series-nav__item a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .series-nav__item.is-current {
    color: var(--accent);
    font-weight: 500;
  }
  .series-nav__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .series-nav__pager-link {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    transition: border-color 150ms ease;
  }
  .series-nav__pager-link:hover {
    border-color: var(--accent);
    color: inherit;
    text-decoration: none;
  }
  .series-nav__pager-link--next {
    text-align: right;
  }
  .series-nav__pager-label {
    font-size: var(--step--2);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .series-nav__pager-title {
    font-family: var(--font-serif);
    color: var(--text);
    margin-top: 0.25rem;
  }
  .series-nav__pager-link:hover .series-nav__pager-title {
    color: var(--accent);
  }

  @media (max-width: 540px) {
    .series-nav__pager {
      grid-template-columns: 1fr;
    }
  }
</style>
