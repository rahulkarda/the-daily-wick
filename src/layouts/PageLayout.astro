---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  heading: string;
  lede?: string;
}

const { title, description, eyebrow, heading, lede } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="page">
    <header class="page__header container container--narrow">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="page__heading">{heading}</h1>
      {lede && <p class="page__lede">{lede}</p>}
    </header>
    <div class="prose container container--narrow page__body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block: 4rem 2rem;
  }
  .page__header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .page__heading {
    font-size: var(--step-3);
    margin: 0.5rem 0 1rem;
  }
  .page__lede {
    color: var(--text-muted);
    font-size: var(--step-1);
    font-style: italic;
    font-family: var(--font-serif);
    text-wrap: balance;
    max-width: 36rem;
    margin: 0 auto;
  }
  .page__body :global(h2) {
    font-size: var(--step-2);
    margin-top: 2.5em;
  }
</style>
