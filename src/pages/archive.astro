---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDateShort, getYear, getMonthKey } from '@/lib/format-date';
import { path } from '@/lib/path';
import { themeSlug, groupByTheme, groupByTag } from '@/lib/theme';

const all = await getCollection('posts', ({ data }) => !data.draft);
all.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const MONTH_NAMES = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];

// VIEW 1 — chronological (year → month → posts)
type Post = (typeof all)[number];
const byYear: Record<string, Record<string, Post[]>> = {};
for (const p of all) {
  const y = String(getYear(p.data.pubDate));
  const m = getMonthKey(p.data.pubDate);
  byYear[y] ??= {};
  byYear[y][m] ??= [];
  byYear[y][m].push(p);
}
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
const themesByMonth: Record<string, string> = {};
for (const p of all) {
  themesByMonth[getMonthKey(p.data.pubDate)] = p.data.monthlyTheme;
}

// VIEW 2 — by theme (post-count desc)
const byTheme = [...groupByTheme(all).entries()].sort(
  (a, b) => b[1].length - a[1].length,
);

// VIEW 3 — by tag (post-count desc, already sorted)
const byTag = groupByTag(all);
---

<BaseLayout title="Archive" description="Every post — sortable by date, theme, or tag.">
  <section class="archive container">
    <header class="archive__header">
      <p class="eyebrow">The whole shelf</p>
      <h1>Archive</h1>
      <p>{all.length} {all.length === 1 ? 'post' : 'posts'}. Sort the way you think.</p>
    </header>

    <!-- Three radio inputs control which panel is shown via :checked + sibling selector -->
    <div class="tabs" data-tabs>
      <input type="radio" name="view" id="view-date" checked />
      <input type="radio" name="view" id="view-theme" />
      <input type="radio" name="view" id="view-tag" />

      <div class="tab-buttons" role="tablist">
        <label
          for="view-date"
          id="tab-date"
          class="tab-button"
          role="tab"
          tabindex="0"
          aria-controls="panel-date"
          aria-selected="true"
          data-tab-target="view-date"
        >By date</label>
        <label
          for="view-theme"
          id="tab-theme"
          class="tab-button"
          role="tab"
          tabindex="-1"
          aria-controls="panel-theme"
          aria-selected="false"
          data-tab-target="view-theme"
        >By theme</label>
        <label
          for="view-tag"
          id="tab-tag"
          class="tab-button"
          role="tab"
          tabindex="-1"
          aria-controls="panel-tag"
          aria-selected="false"
          data-tab-target="view-tag"
        >By tag</label>
      </div>

      <!-- BY DATE -->
      <section
        id="panel-date"
        class="tab-panel tab-panel--date"
        role="tabpanel"
        aria-labelledby="tab-date"
      >
        {years.map((y) => {
          const months = Object.keys(byYear[y]).sort((a, b) => b.localeCompare(a));
          return (
            <section class="year">
              <h2 class="year__heading">{y}</h2>
              {months.map((m) => {
                const posts = byYear[y][m];
                const monthName = MONTH_NAMES[Number(m.split('-')[1]) - 1];
                const theme = themesByMonth[m];
                return (
                  <details class="month" open>
                    <summary>
                      <span class="month__name">{monthName}</span>
                      <span class="month__count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
                      {theme && <a class="theme-tag" href={path(`/themes/${themeSlug(theme)}`)}>{theme}</a>}
                    </summary>
                    <ul class="month__list">
                      {posts.map((p) => (
                        <li>
                          <time datetime={p.data.pubDate.toISOString()}>{formatDateShort(p.data.pubDate)}</time>
                          <a href={path(`/articles/${p.slug}`)}>{p.data.title}</a>
                          {p.data.format === 'essay' && <span class="format-pip">Essay</span>}
                        </li>
                      ))}
                    </ul>
                  </details>
                );
              })}
            </section>
          );
        })}
      </section>

      <!-- BY THEME -->
      <section
        id="panel-theme"
        class="tab-panel tab-panel--theme"
        role="tabpanel"
        aria-labelledby="tab-theme"
      >
        {byTheme.map(([theme, posts]) => (
          <details class="theme-block" open>
            <summary>
              <span class="theme-block__name">{theme}</span>
              <span class="theme-block__count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
              <a class="theme-block__link" href={path(`/themes/${themeSlug(theme)}`)}>view →</a>
            </summary>
            <ul class="month__list">
              {posts.map((p) => (
                <li>
                  <time datetime={p.data.pubDate.toISOString()}>{formatDateShort(p.data.pubDate)}</time>
                  <a href={path(`/articles/${p.slug}`)}>{p.data.title}</a>
                  {p.data.format === 'essay' && <span class="format-pip">Essay</span>}
                </li>
              ))}
            </ul>
          </details>
        ))}
      </section>

      <!-- BY TAG -->
      <section
        id="panel-tag"
        class="tab-panel tab-panel--tag"
        role="tabpanel"
        aria-labelledby="tab-tag"
      >
        {byTag.map(([tag, posts]) => (
          <details class="tag-block">
            <summary>
              <span class="tag-block__name">#{tag}</span>
              <span class="tag-block__count">{posts.length}</span>
              <a class="tag-block__link" href={path(`/topics/${tag}`)}>view →</a>
            </summary>
            <ul class="month__list">
              {posts.map((p) => (
                <li>
                  <time datetime={p.data.pubDate.toISOString()}>{formatDateShort(p.data.pubDate)}</time>
                  <a href={path(`/articles/${p.slug}`)}>{p.data.title}</a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    padding-block: 4rem 2rem;
    max-width: 48rem;
  }
  .archive__header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .archive__header h1 {
    font-size: var(--step-3);
    margin: 0.5rem 0 1rem;
  }

  /* Tabs — radio + sibling selectors. No JS required. */
  .tabs > input[type='radio'] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .tab-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.5rem;
  }
  .tab-button {
    cursor: pointer;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    color: var(--text-muted);
    font-size: var(--step--1);
    transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease;
  }
  .tab-button:hover {
    color: var(--text);
    border-color: var(--text-muted);
  }
  .tabs > input:focus-visible ~ .tab-buttons label[data-tab-target] {
    /* Keyboard focus on the (visually hidden) radio is hard to spot — but
       we also handle focus on the labels via :focus-visible below, and the
       JS arrow-key handler moves focus among labels (roving tabindex). */
  }
  .tab-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* Active tab: tint */
  #view-date:checked ~ .tab-buttons label[for='view-date'],
  #view-theme:checked ~ .tab-buttons label[for='view-theme'],
  #view-tag:checked ~ .tab-buttons label[for='view-tag'] {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .tab-panel {
    display: none;
  }
  #view-date:checked ~ .tab-panel--date,
  #view-theme:checked ~ .tab-panel--theme,
  #view-tag:checked ~ .tab-panel--tag {
    display: block;
  }

  .year {
    margin-bottom: 3rem;
  }
  .year__heading {
    font-size: var(--step-2);
    color: var(--text-muted);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }

  .month, .theme-block, .tag-block {
    margin-bottom: 1.5rem;
  }
  .month summary, .theme-block summary, .tag-block summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    cursor: pointer;
    padding: 0.5rem 0;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::before {
    content: '▾';
    color: var(--text-muted);
    transition: transform 150ms ease;
  }
  details:not([open]) > summary::before {
    transform: rotate(-90deg);
    display: inline-block;
  }
  .month__name, .theme-block__name, .tag-block__name {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 500;
  }
  .tag-block__name {
    font-family: var(--font-sans);
    color: var(--accent);
  }
  .month__count, .theme-block__count, .tag-block__count {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .theme-block__link, .tag-block__link {
    margin-left: auto;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .month__list {
    list-style: none;
    padding-left: 1.5rem;
    margin: 0.75rem 0 0;
  }
  .month__list li {
    display: grid;
    grid-template-columns: 8rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.4rem;
    border-bottom: 1px dashed var(--rule);
  }
  .month__list time {
    color: var(--text-muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }
  .month__list a {
    color: var(--text);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .month__list a:hover {
    color: var(--accent);
  }
  .format-pip {
    font-size: var(--step--2);
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  @media (max-width: 540px) {
    .month__list li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  .theme-tag {
    text-decoration: none;
  }
</style>

<script>
  // Roving-tabindex + arrow-key keyboard nav for the tablist, and
  // aria-selected sync when a tab is activated. The CSS above already
  // controls panel visibility via :checked; we only handle a11y attributes
  // and keyboard semantics here.
  (function () {
    const tabsRoot = document.querySelector<HTMLElement>('[data-tabs]');
    if (!tabsRoot) return;
    const tabs = Array.from(tabsRoot.querySelectorAll<HTMLElement>('[role="tab"]'));
    if (tabs.length === 0) return;

    function syncSelected() {
      tabs.forEach((tab) => {
        const targetId = tab.dataset.tabTarget!;
        const radio = document.getElementById(targetId) as HTMLInputElement | null;
        const isSelected = !!radio?.checked;
        tab.setAttribute('aria-selected', String(isSelected));
        tab.setAttribute('tabindex', isSelected ? '0' : '-1');
      });
    }

    function activate(idx: number, focus: boolean) {
      const tab = tabs[idx];
      if (!tab) return;
      const radio = document.getElementById(tab.dataset.tabTarget!) as HTMLInputElement | null;
      if (radio) radio.checked = true;
      syncSelected();
      if (focus) tab.focus();
    }

    tabs.forEach((tab, idx) => {
      // Click on label already toggles the radio; we just sync state.
      tab.addEventListener('click', () => syncSelected());
      tab.addEventListener('keydown', (ev) => {
        const key = (ev as KeyboardEvent).key;
        if (key === 'ArrowRight' || key === 'ArrowDown') {
          ev.preventDefault();
          activate((idx + 1) % tabs.length, true);
        } else if (key === 'ArrowLeft' || key === 'ArrowUp') {
          ev.preventDefault();
          activate((idx - 1 + tabs.length) % tabs.length, true);
        } else if (key === 'Home') {
          ev.preventDefault();
          activate(0, true);
        } else if (key === 'End') {
          ev.preventDefault();
          activate(tabs.length - 1, true);
        } else if (key === 'Enter' || key === ' ') {
          ev.preventDefault();
          activate(idx, true);
        }
      });
    });

    syncSelected();
  })();
</script>
